# Copy this file to .env (same directory) and fill in real values before
# running `docker compose up`. .env is gitignored — docker-compose.yml has
# no fallback for these, so it fails with a clear error if .env is missing
# or incomplete, rather than silently using a value committed anywhere.

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Shared bearer tokens internal/auth's middleware maps to roles (7.7.1/
# 7.7.2) — GATEWAY_AUTH_TOKEN authenticates as auth.RoleUser,
# GATEWAY_ADMIN_AUTH_TOKEN as auth.RoleAdmin (a strict superset — see
# internal/auth/authorization.go). Pick two distinct, long random
# strings for local dev — neither is a service credential, just a
# shared secret between this gateway and its callers.
GATEWAY_AUTH_TOKEN=
GATEWAY_ADMIN_AUTH_TOKEN=

# The Chrome extension's own, separate, minimum-privilege token (8.1,
# auth.ExtensionMiddleware) — authorizes exactly one route,
# POST /api/v1/auth/session, where the extension exchanges it for a
# short-lived session credential (see internal/sessioncred). Pick a
# third distinct random string; this is what belongs in the extension's
# own config, never GATEWAY_AUTH_TOKEN or GATEWAY_ADMIN_AUTH_TOKEN.
GATEWAY_EXTENSION_TOKEN=
