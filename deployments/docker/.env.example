# Copy this file to .env (same directory) and fill in real values before
# running `docker compose up`. .env is gitignored — docker-compose.yml has
# no fallback for these, so it fails with a clear error if .env is missing
# or incomplete, rather than silently using a value committed anywhere.

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Shared bearer token internal/auth's middleware requires on every
# /api/v1/* request (see GATEWAY_AUTH_TOKEN in internal/config). Pick
# any long random string for local dev — it isn't a service credential,
# just a shared secret between this gateway and its callers.
GATEWAY_AUTH_TOKEN=
